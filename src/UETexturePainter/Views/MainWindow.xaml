<Window x:Class="UETexturePainter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:UETexturePainter.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:UETexturePainter.ViewModels"
        mc:Ignorable="d"
        Title="UE Texture Painter" Height="900" Width="1400" Background="#1E1E1E">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252526" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Tool" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding ToolOptions}" SelectedItem="{Binding SelectedTool}" Margin="0,8,0,16" />

                    <TextBlock Text="Brush" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Size" Foreground="#CCCCCC" />
                    <Slider Minimum="1" Maximum="256" Value="{Binding Brush.Size}" />
                    <TextBlock Text="Hardness" Foreground="#CCCCCC" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Brush.Hardness}" />
                    <TextBlock Text="Opacity" Foreground="#CCCCCC" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Brush.Opacity}" />
                    <TextBlock Text="Flow" Foreground="#CCCCCC" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Brush.Flow}" />

                    <TextBlock Text="Color" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Rectangle Width="32" Height="32" Fill="{Binding BrushColorBrush}" Stroke="Black" />
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Hue" Foreground="#CCCCCC" />
                            <Slider Minimum="0" Maximum="360" Value="{Binding ColorPicker.Hue}" />
                            <TextBlock Text="Saturation" Foreground="#CCCCCC" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding ColorPicker.Saturation}" />
                            <TextBlock Text="Value" Foreground="#CCCCCC" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding ColorPicker.Value}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Palette" Foreground="#CCCCCC" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding PaletteColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="24" Height="24" Margin="2"
                                        Background="{Binding}" BorderBrush="#333"
                                        Command="{Binding DataContext.SelectPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Channels" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}" Margin="0,8,0,16" />
                    <TextBlock Text="Blend Mode" Foreground="#CCCCCC" />
                    <ComboBox ItemsSource="{Binding BlendModeOptions}" SelectedItem="{Binding Brush.BlendMode}" Margin="0,8,0,16" />

                    <TextBlock Text="Export" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Target Folder" Foreground="#CCCCCC" Margin="0,8,0,0" />
                    <TextBox Text="{Binding TargetFolder}" />
                    <TextBlock Text="Format" Foreground="#CCCCCC" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding ExportFormatOptions}" SelectedItem="{Binding ExportFormat}" Margin="0,4,0,8" />

                    <Button Content="Export" Command="{Binding ExportCommand}" Margin="0,8,0,0" />
                    <Button Content="Generate UE Script" Command="{Binding GenerateScriptCommand}" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="#1B1B1B" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Canvas" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Resolution" Foreground="#CCCCCC" Margin="16,0,0,0" />
                    <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}" Width="140" Margin="8,0,0,0" />
                    <TextBlock Text="Asset Name" Foreground="#CCCCCC" Margin="16,0,0,0" />
                    <TextBox Text="{Binding AssetName}" Width="200" Margin="8,0,0,0" />
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="#333" BorderThickness="1" Background="#111">
                    <Grid>
                        <Image Source="{Binding CompositeBitmap}" Stretch="Uniform"/>
                        <Image Source="{Binding UvOverlay}" Stretch="Uniform" Opacity="0.4" />
                        <Rectangle Fill="Transparent" local:PaintInputBehavior.IsEnabled="True"
                                   local:PaintInputBehavior.ViewModel="{Binding}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="#252526" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Layers" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ActiveLayerStack.Layers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#333" BorderThickness="1" Margin="0,4,0,0" Padding="8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsVisible}" Content="" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" Foreground="White" />
                                            <Button Content="▲" Command="{Binding DataContext.MoveLayerUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                                            <Button Content="▼" Command="{Binding DataContext.MoveLayerDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="4,0,0,0" />
                                            <Button Content="Merge" Command="{Binding DataContext.MergeLayerDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="4,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="Opacity" Foreground="#CCCCCC" />
                                        <Slider Minimum="0" Maximum="1" Value="{Binding Opacity}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add Layer" Command="{Binding AddLayerCommand}" Margin="0,12,0,0" />
                    <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,8,0,0" />
                    <Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,8,0,0" />

                    <TextBlock Text="Import" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <Button Content="Import Texture" Command="{Binding ImportTextureCommand}" Margin="0,8,0,0" />
                    <Button Content="Load UV Overlay" Command="{Binding LoadUvCommand}" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
